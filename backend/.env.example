# ============================================================
# TASKFLOW BACKEND ENVIRONMENT
# ============================================================

# Server
PORT=10000
NODE_ENV=development

# Database
# Local development:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/taskflow?schema=public"

# Production:
# DATABASE_URL="YOUR_NEON_CONNECTION_STRING"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1h"

# Frontend
# Local:
FRONTEND_URL="http://localhost:5173"

# Production:
# FRONTEND_URL="https://your-taskflow.vercel.app"

# Optional
# If you later use a separate Neon direct connection for migrations:
# DIRECT_URL="YOUR_NEON_DIRECT_CONNECTION_STRING"